{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study OS",
  "version": "0.1.0",
  "identifier": "com.studyos.gate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Study OS",
        "width": 1280,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 720,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": []
  }
}
